// Let vsitzmann (and agents running as him) deploy DeckWerk and TeXWerk
// without sudo: start exactly these two units, nothing else.
polkit.addRule(function (action, subject) {
  if (action.id == "org.freedesktop.systemd1.manage-units" &&
      subject.user == "vsitzmann" &&
      action.lookup("verb") == "start" &&
      ["deckwerk-update.service", "texwerk-deploy.service"].indexOf(action.lookup("unit")) >= 0) {
    return polkit.Result.YES;
  }
});
