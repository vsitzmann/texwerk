# Deploy the committed HEAD of the checkout to /srv/texwerk/app, without sudo:
#
#   systemctl start texwerk-deploy && journalctl -u texwerk-deploy -n 20 --no-pager
#
# Runs a root-owned copy of deploy/update.sh (/usr/local/bin/texwerk-update),
# so editing the checkout never changes what runs as root. The build itself
# runs as texwerk. deploy/50-werk-deploy.rules lets the checkout's owner start
# this unit (and deckwerk-update.service) without a password.
[Unit]
Description=Deploy TeXWerk from the checkout's committed HEAD and restart

[Service]
Type=oneshot
Environment=TEXWERK_SRC=/home/vsitzmann/Work/texwerk
ExecStart=/usr/local/bin/texwerk-update --force
TimeoutStartSec=900
